# ==========================================
# Amazon ML Challenge 2026 - .gitignore
# ==========================================

# --- Large Datasets & Raw Data (>100MB, cannot be committed to GitHub) ---
student_resource/dataset/
student_resource/*.zip
data/
*.tsv
*.csv
*.parquet
*.feather
*.h5
*.hdf5
*.sqlite
*.db
*.zip
*.tar
*.tar.gz
*.7z
*.rar

# --- Generated Submissions & Outputs ---
output/
*_submission.zip

# --- Model Artifacts, Weights & Checkpoints ---
models/
*.bin
*.joblib
*.pkl
*.pickle
*.pt
*.pth
*.onnx
*.safetensors
*.model

# --- Python Build & Bytecode Artifacts ---
__pycache__/
*.py[cod]
*$py.class
*.so
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# --- Virtual Environments ---
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/
conda-env/

# --- IDE & Editor Settings ---
.idea/
.vscode/
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace

# --- Operating System Files ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# --- Jupyter Notebooks Checkpoints ---
.ipynb_checkpoints/
*-checkpoint.ipynb

# --- Logs, Diagnostics & Temp Folders ---
*.log
scratch/
tmp/
temp/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- Secrets & Environment Variables ---
.env
.env.*
*.pem
*.key
